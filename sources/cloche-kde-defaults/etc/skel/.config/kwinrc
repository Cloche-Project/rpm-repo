[Desktops]
Number=1
Rows=1

[EdgeBarrier]
EdgeBarrier=25

[Effect-blur]
BlurStrength=3
NoiseStrength=2

[Plugins]
blurEnabled=true
sheetEnabled=true

[Script-krohnkite]
screenGapBetween=4
screenGapBottom=4
screenGapLeft=4
screenGapRight=4
screenGapTop=4

[TabBox]
LayoutName=sidebar

[Wayland]
InputMethod[$e]=$HOME/.local/share/applications/com.github.maliit.keyboard.desktop
VirtualKeyboardEnabled=true

[Windows]
FocusPolicy=FocusFollowsMouse

[Xwayland]
Scale=1
